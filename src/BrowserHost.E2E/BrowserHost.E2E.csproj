<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>BrowserHost.E2E</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- Standard CefSharp WPF package; brings native/runtime assets via NuGet build targets -->
    <PackageReference Include="CefSharp.Wpf.NetCore" Version="143.0.90" />
    <PackageReference Include="CefSharp.Common.NETCore" Version="143.0.90" />

    <PackageReference Include="Testably.Abstractions.Testing" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserHost\BrowserHost.csproj" />
  </ItemGroup>

</Project>
